# Copy to .env.local (local) or paste into Vercel -> Settings -> Environment Variables.
# NEVER commit real values. None of these are NEXT_PUBLIC_ — they stay on the server.

# ── Database (Neon, free tier is plenty) ─────────────────────────────────────
# Pooled string (host contains "-pooler"): what the running app uses.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct string (same, WITHOUT "-pooler"): used only by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Admin sign-in ────────────────────────────────────────────────────────────
# The password you type at /admin/login. Use a long one. Changing it signs every session out.
ADMIN_PASSWORD=""
# Signs the session cookie. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=""

# ── Public URL ───────────────────────────────────────────────────────────────
# What short links are shown under in the dashboard (no trailing slash).
SHORT_LINK_BASE_URL="https://uudamtravel.mn"

# ── Optional ─────────────────────────────────────────────────────────────────
# Extra hostnames that count as "your own website" (comma-separated). The host of
# SHORT_LINK_BASE_URL is always included.
OWN_HOSTS=""
# Destination hostnames nobody may shorten (comma-separated; sub-domains included).
BLOCKED_DESTINATION_HOSTS=""
